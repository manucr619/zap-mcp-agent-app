# Database Configuration
POSTGRES_DB=moderor_db
POSTGRES_USER=moderor_user
POSTGRES_PASSWORD=moderor_password
DATABASE_URL=postgresql://moderor_user:moderor_password@db:5432/modor_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# ChromaDB Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# OWASP ZAP Configuration
ZAP_HOST=zap-scanner
ZAP_PORT=8080

# MCP Server Configuration
MCP_SERVER_HOST=mcp-server
MCP_SERVER_PORT=3000

# Django Backend Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-12345678901234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8001
REACT_APP_WS_URL=ws://localhost:8001/ws

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security & Performance
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# API Rate Limiting
RATE_LIMIT_ANON=100/hour
RATE_LIMIT_USER=1000/hour

# ZAP API Configuration
ZAP_API_KEY=your-zap-api-key-here
ZAP_BASE_URL=http://zap-scanner:8080

# ChromaDB API Configuration
CHROMA_API_URL=http://chromadb:8000

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# File Upload Settings
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,txt,json,xml,yaml,yml
