# Example: Security scan API endpoint
@api_view(['POST'])
@permission_classes([IsAuthenticated])
async def initiate_security_scan(request: Request) -> Response:
    """
    Initiate comprehensive API security scan using OWASP ZAP.
    
    Args:
        request: HTTP request with scan configuration
        
